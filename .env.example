# Copy to .env in the Carnivario root and fill in local credentials.
# Keep .env private. Never commit real credentials.
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Management UI: http://localhost:15672 (use the credentials from .env).
# These values initialize a new data volume. Changing this file does not
# update credentials already stored in an existing RabbitMQ volume.
